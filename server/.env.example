# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# gemini-3.6-flash = cheap/fast, great default for a scan-heavy free tier.
# gemini-3.6-pro   = higher accuracy on tricky/rare species, more expensive.
# Google renames/retires models over time (gemini-2.5-flash was retired for
# new API keys as of this writing) — if analyze calls start 404ing, check
# https://ai.google.dev/gemini-api/docs/models for the current model id.
GEMINI_MODEL=gemini-3.6-flash

PORT=8787

# Comma-separated list of origins allowed to call this server.
# The mobile app itself doesn't need CORS (it's not a browser), but this
# matters if you ever add a web/admin client.
CORS_ORIGINS=*

# Free-tier cost protection: max analyze calls per device per day.
# Pro subscribers bypass this (enforced via the X-Pro-Entitlement header,
# which you should upgrade to a signed RevenueCat webhook check before launch).
FREE_SCANS_PER_DAY=5
