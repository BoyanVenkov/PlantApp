# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# gemini-3.5-flash-lite = cheapest ($0.30 / $2.50 per 1M tokens), the default.
# gemini-3.6-flash      = more accurate on tricky species, ~2-3x the cost per scan.
# Each scan logs its real token usage and cost in the server console.
# Google renames/retires models over time (gemini-2.5-flash was retired for
# new API keys as of this writing) — if analyze calls start 404ing, check
# https://ai.google.dev/gemini-api/docs/models for the current model id.
GEMINI_MODEL=gemini-3.5-flash-lite

# USD per 1M tokens, only used for the per-scan cost log. Match your model.
GEMINI_PRICE_INPUT_PER_M=0.30
GEMINI_PRICE_OUTPUT_PER_M=2.50

PORT=8787

# Comma-separated list of origins allowed to call this server.
# The mobile app itself doesn't need CORS (it's not a browser), but this
# matters if you ever add a web/admin client.
CORS_ORIGINS=*

# Cost protection: hard max analyze calls per device per day, for everyone.
# Keep equal to EXPO_PUBLIC_DAILY_SCAN_CAP in mobile/.env.
DAILY_SCAN_CAP=15
