# Copy to .env and fill in. Expo automatically inlines any EXPO_PUBLIC_*
# var into the JS bundle at build time — do NOT put secrets here, only
# client-safe identifiers (the Gemini key lives on the server, never here).

# Your backend from /server. Use your machine's LAN IP (not localhost) when
# testing on a physical device, e.g. http://192.168.1.23:8787
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# From https://app.revenuecat.com -> Project -> API Keys.
# Leave blank during development: subscriptions.ts falls back to a mock
# "always free tier" mode so the app still runs without a RevenueCat account.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# The entitlement identifier you configure in RevenueCat for "ads removed".
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Google's public TEST ad unit IDs (safe defaults, always fill real ones
# before release). Get real ones from https://apps.admob.com
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=ca-app-pub-3940256099942544/2934735716
EXPO_PUBLIC_ADMOB_BANNER_ID_ANDROID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_IOS=ca-app-pub-3940256099942544/4411468910
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_ANDROID=ca-app-pub-3940256099942544/1033173712

# Show an interstitial after every Nth scan (never for Pro users).
EXPO_PUBLIC_INTERSTITIAL_EVERY_N_SCANS=3

# Soft client-side daily cap shown pre-emptively in the UI. The real
# enforcement lives server-side in server/.env (FREE_SCANS_PER_DAY) — keep
# these two numbers equal.
EXPO_PUBLIC_FREE_SCANS_PER_DAY=5
