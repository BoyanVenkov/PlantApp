{
  "expo": {
    "name": "Sproutly",
    "slug": "sproutly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sproutly",
    "splash": {
      "backgroundColor": "#0f5132"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.svg"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plantapp.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Sproutly needs your camera to take photos of your plants for identification.",
        "NSPhotoLibraryUsageDescription": "Sproutly needs access to your photos so you can pick existing pictures of your plants."
      }
    },
    "android": {
      "package": "com.plantapp.mobile",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f5132"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sproutly needs access to your photos so you can pick existing pictures of your plants.",
          "cameraPermission": "Sproutly needs your camera to take photos of your plants for identification."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0f5132"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ]
  }
}
